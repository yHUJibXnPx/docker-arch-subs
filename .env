# ------------------------------
# 通用配置
# ------------------------------
PLATFORM=linux/arm64/v8
TIMEZONE=Asia/Shanghai
LOGGING_DRIVER=json-file
LOG_MAX_SIZE=1m
NETWORK_TYPE=bridge
TTY=true
TIMEZONE_VOLUME=/etc/localtime:/etc/localtime:ro

# ------------------------------
# SUB_STORE 配置
# ------------------------------
IMAGE_SUB_STORE=ghcr.io/xream/sub-store:latest
CONTAINER_SUB_STORE=sub_store_container
PORT_SUB_STORE_3001=3001:3001
SUB_STORE_FRONTEND_BACKEND_PATH=/sub-store
CAP_ADD_SUB_STORE_1=SYS_ADMIN
CAP_ADD_SUB_STORE_2=NET_ADMIN
SECURITY_OPT_SUB_STORE_1=seccomp:unconfined
CPUS_MIN_SUB_STORE=8
CPUS_SUB_STORE=0.8
CPUS_SHARES_SUB_STORE=256
MEM_LIMIT_SUB_STORE=512M
MEM_LIMIT_MIN_SUB_STORE=511M
MEMSWAP_LIMIT_SUB_STORE=512M
MEM_SWAPPINESS_SUB_STORE=0
INIT_SUB_STORE=true
STOP_SIGNAL_SUB_STORE=SIGKILL
STOP_GRACE_PERIOD_SUB_STORE=1s
PRIVILEGED_SUB_STORE=true
RESTART_POLICY_SUB_STORE=always

# ------------------------------
# 挂载路径
# ------------------------------
CACHE_SUB_STORE=./sub_store_data:/opt/app/data

# ------------------------------
# SUBCONVERTER 配置
# ------------------------------
#IMAGE_SUBCONVERTER=docker.io/tindy2013/subconverter:latest
#IMAGE_SUBCONVERTER=ghcr.io/metacubex/subconverter:latest
#IMAGE_SUBCONVERTER=ghcr.io/0ekk/subconverter:latest
IMAGE_SUBCONVERTER=docker.io/asdlokj1qpi23/subconverter:latest
CONTAINER_SUBCONVERTER=subconverter_container
PORT_SUBCONVERTER_25500=25500:25500
CAP_ADD_SUBCONVERTER_1=SYS_ADMIN
CAP_ADD_SUBCONVERTER_2=NET_ADMIN
SECURITY_OPT_SUBCONVERTER_1=seccomp:unconfined
CPUS_MIN_SUBCONVERTER=8
CPUS_SUBCONVERTER=0.8
CPUS_SHARES_SUBCONVERTER=256
MEM_LIMIT_SUBCONVERTER=512M
MEM_LIMIT_MIN_SUBCONVERTER=511M
MEMSWAP_LIMIT_SUBCONVERTER=512M
MEM_SWAPPINESS_SUBCONVERTER=0
INIT_SUBCONVERTER=true
STOP_SIGNAL_SUBCONVERTER=SIGKILL
STOP_GRACE_PERIOD_SUBCONVERTER=1s
PRIVILEGED_SUBCONVERTER=true
RESTART_POLICY_SUBCONVERTER=always

# ------------------------------
# 挂载路径
# ------------------------------
CACHE_SUBCONVERTER=./subconverter/base:/base

# ------------------------------
# SUBWEB 配置
# ------------------------------
IMAGE_SUBWEB=docker.io/youshandefeiyang/sub-web-modify:latest
CONTAINER_SUBWEB=subweb_container
PORT_SUBWEB_80=58080:80
CAP_ADD_SUBWEB_1=SYS_ADMIN
CAP_ADD_SUBWEB_2=NET_ADMIN
SECURITY_OPT_SUBWEB_1=seccomp:unconfined
CPUS_MIN_SUBWEB=0.1
CPUS_SUBWEB=0.1
CPUS_SHARES_SUBWEB=256
MEM_LIMIT_SUBWEB=16M
MEM_LIMIT_MIN_SUBWEB=15M
MEMSWAP_LIMIT_SUBWEB=16M
MEM_SWAPPINESS_SUBWEB=0
INIT_SUBWEB=true
STOP_SIGNAL_SUBWEB=SIGKILL
STOP_GRACE_PERIOD_SUBWEB=1s
PRIVILEGED_SUBWEB=true
RESTART_POLICY_SUBWEB=always

# ------------------------------
# CFNAT 配置
# ------------------------------
IMAGE_CFNAT=docker.io/cmliu/cfnat:latest
CONTAINER_CFNAT=cfnat_container
PORT_CFNAT_1234=1234:1234
# ------------------------------
# 负载均衡与网络配置
# ------------------------------
# 电信/联通 推荐 SJC,LAX.移动/广电 推荐 HKG
#COLO_CFNAT=HKG,SJC,LAX
COLO_CFNAT=TIA,ALG,AAE,ORN,LAD,EZE,COR,NQN,EVN,ADL,BNE,CBR,HBA,MEL,PER,SYD,VIE,LLK,GYD,BAH,CGP,DAC,JSR,BGI,MSQ,BRU,PBH,LPB,GBE,QWJ,ARU,BEL,CNF,BNU,BSB,CFC,VCP,CAW,XAP,CGB,CWB,FLN,FOR,GYN,ITJ,JOI,JDO,MAO,PMW,POA,REC,RAO,GIG,SSA,SJP,SJK,GRU,SOD,NVT,UDI,VIX,BWN,SOF,OUA,PNH,YYC,YVR,YWG,YHZ,YOW,YYZ,YUL,YXE,ARI,SCL,BAQ,BOG,MDE,FIH,SJO,ABJ,ASK,ZAG,LCA,PRG,CPH,JIB,STI,SDQ,GYE,UIO,CAI,TLL,SUV,HEL,BOD,LYS,MRS,CDG,PPT,TBS,TXL,DUS,FRA,HAM,MUC,STR,ACC,ATH,SKG,GND,GUM,GUA,GEO,TGU,HKG,BUD,KEF,AMD,BLR,BBI,IXC,MAA,HYD,CNN,KNU,COK,CCU,BOM,NAG,DEL,PAT,DPS,CGK,JOG,BGW,BSR,EBL,NJF,XNH,ISU,ORK,DUB,HFA,TLV,MXP,PMO,FCO,KIN,FUK,OKA,KIX,NRT,AMM,ALA,NQZ,MBA,NBO,ICN,KWI,VTE,RIX,BEY,VNO,LUX,MFM,TNR,JHB,KUL,MLE,MRU,GDL,MEX,QRO,KIV,ULN,MPM,MDL,RGN,WDH,KTM,AMS,NOU,AKL,CHC,LOS,SKP,OSL,MCT,ISB,KHI,LHE,ZDM,PTY,ASU,LIM,CGY,CEB,MNL,CRK,WAW,LIS,SJU,DOH,RUN,OTP,KJA,DME,LED,KLD,SVX,KGL,DMM,JED,RUH,DKR,BEG,SIN,BTS,CPT,DUR,JNB,BCN,MAD,CMB,PBM,GOT,ARN,GVA,ZRH,KHH,TPE,DAR,BKK,CNX,URT,POS,TUN,IST,ADB,EBB,KBP,DXB,EDI,LHR,MAN,MGM,ANC,PHX,LAX,SMF,SAN,SFO,SJC,DEN,JAX,MIA,TLH,TPA,ATL,HNL,ORD,IND,BGR,BOS,DTW,MSP,MCI,STL,OMA,LAS,EWR,ABQ,BUF,CLT,RDU,CLE,CMH,OKC,PDX,PHL,PIT,FSD,MEM,BNA,AUS,DFW,IAH,MFE,SAT,SLC,IAD,ORF,RIC,SEA,TAS,DAD,HAN,SGN,HRE
DELAY_CFNAT=300
IPS_CFNAT=4
PORT_CFNAT_443=443
TLS_CFNAT=true
RANDOM_CFNAT=true
IPNUM_CFNAT=10
NUM_CFNAT=5
TASK_CFNAT=2
CODE_CFNAT=200
DOMAIN_CFNAT=cloudflaremirrors.com/debian
CAP_ADD_CFNAT_1=SYS_ADMIN
CAP_ADD_CFNAT_2=NET_ADMIN
SECURITY_OPT_CFNAT_1=seccomp:unconfined
CPUS_MIN_CFNAT=0.3
CPUS_CFNAT=0.3
CPUS_SHARES_CFNAT=256
MEM_LIMIT_CFNAT=64M
MEM_LIMIT_MIN_CFNAT=63M
MEMSWAP_LIMIT_CFNAT=64M
MEM_SWAPPINESS_CFNAT=0
INIT_CFNAT=true
STOP_SIGNAL_CFNAT=SIGKILL
STOP_GRACE_PERIOD_CFNAT=1s
PRIVILEGED_CFNAT=true
RESTART_POLICY_CFNAT=always

# ------------------------------
# Subs-Check 配置
# ------------------------------
IMAGE_SUBS_CHECK=ghcr.io/beck-8/subs-check:latest
CONTAINER_SUBS_CHECK=subs_check_container
NODE_OPTIONS_SUBS_CHECK=--max-old-space-size=128
PORT_SUBS_CHECK_8199=8199:8199
PORT_SUBS_CHECK_8299=8299:8299
CAP_ADD_SUBS_CHECK_1=SYS_ADMIN
CAP_ADD_SUBS_CHECK_2=NET_ADMIN
SECURITY_OPT_SUBS_CHECK_1=seccomp:unconfined
CPUS_MIN_SUBS_CHECK=0.4
CPUS_SUBS_CHECK=0.4
CPUS_SHARES_SUBS_CHECK=256
MEM_LIMIT_SUBS_CHECK=384M
MEM_LIMIT_MIN_SUBS_CHECK=383M
MEMSWAP_LIMIT_SUBS_CHECK=384M
MEM_SWAPPINESS_SUBS_CHECK=0
INIT_SUBS_CHECK=true
STOP_SIGNAL_SUBS_CHECK=SIGKILL
STOP_GRACE_PERIOD_SUBS_CHECK=1s
PRIVILEGED_SUBS_CHECK=true
RESTART_POLICY_SUBS_CHECK=always

# ------------------------------
# 挂载路径
# ------------------------------
SUBS_CHECK_CONFIG=./subs-check/config:/app/config
SUBS_CHECK_OUTPUT=./subs-check/output:/app/output

# ------------------------------
# 代理配置
# ------------------------------
PROXY_HTTP=http://192.168.255.253:7890
PROXY_HTTPS=http://192.168.255.253:7890
PROXY_ALL=socks5://192.168.255.253:7890
PROXY_NO=localhost,127.0.0.1,192.168.255.0/24
